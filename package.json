{
  "name": "mdview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A local Markdown reader with GitHub-style rendering, a file sidebar, a table of contents and live reload",
  "license": "MIT",
  "bin": {
    "mdview": "bin/mdview.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning bin/mdview.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1"
  }
}
